{
  "routes": [
    {
      "route": "/app",
      "redirect": "/app/",
      "statusCode": 301
    },
    {
      "route": "/privacy",
      "redirect": "/privacy/",
      "statusCode": 301
    },
    {
      "route": "/terms",
      "redirect": "/terms/",
      "statusCode": 301
    },
    {
      "route": "/contact",
      "redirect": "/contact/",
      "statusCode": 301
    },
    {
      "route": "/delete-account",
      "redirect": "/delete-account/",
      "statusCode": 301
    },
    {
      "route": "/admin",
      "redirect": "/admin/",
      "statusCode": 301
    },
    {
      "route": "/about",
      "redirect": "/about/",
      "statusCode": 301
    },
    {
      "route": "/en/about",
      "redirect": "/en/about/",
      "statusCode": 301
    },
    {
      "route": "/tools",
      "redirect": "/tools/",
      "statusCode": 301
    },
    {
      "route": "/en/tools",
      "redirect": "/en/tools/",
      "statusCode": 301
    },
    {
      "route": "/author",
      "redirect": "/author/",
      "statusCode": 301
    },
    {
      "route": "/en/author",
      "redirect": "/en/author/",
      "statusCode": 301
    },
    {
      "route": "/articles",
      "redirect": "/articles/",
      "statusCode": 301
    },
    {
      "route": "/en/articles",
      "redirect": "/en/articles/",
      "statusCode": 301
    },
    {
      "route": "/join/*",
      "rewrite": "/join/index.html"
    },
    {
      "route": "/images/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/media/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "*.css",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    },
    {
      "route": "*.js",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    },
    {
      "route": "/sitemap*.xml",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Content-Security-Policy": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; script-src 'self' 'unsafe-inline' https://cdn.sheetjs.com https://www.googletagmanager.com https://js.monitor.azure.com; connect-src 'self' https://fahsak-api.azurewebsites.net https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com https://westeurope-5.in.applicationinsights.azure.com https://js.monitor.azure.com;",
    "Cache-Control": "public, max-age=3600"
  }
}