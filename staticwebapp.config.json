{
  "routes": [
    { "route": "/privacy", "rewrite": "/privacy/index.html" },
    { "route": "/terms", "rewrite": "/terms/index.html" },
    { "route": "/contact", "rewrite": "/contact/index.html" },
    { "route": "/join/*", "rewrite": "/join/index.html" },
    { "route": "/deck", "rewrite": "/deck/index.html" },
    { "route": "/delete-account", "rewrite": "/delete-account/index.html" },
    { "route": "/admin", "rewrite": "/admin/index.html" },
    { "route": "/about", "rewrite": "/about/index.html" },
    { "route": "/tools", "rewrite": "/tools/index.html" },
    { "route": "/author", "rewrite": "/author/index.html" },
    {
      "route": "/images/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/media/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "*.css",
      "headers": { "Cache-Control": "public, max-age=604800" }
    },
    {
      "route": "*.js",
      "headers": { "Cache-Control": "public, max-age=604800" }
    },
    {
      "route": "/sitemap*.xml",
      "headers": { "Cache-Control": "public, max-age=3600" }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Content-Security-Policy": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; script-src 'self' 'unsafe-inline' https://cdn.sheetjs.com https://www.googletagmanager.com https://js.monitor.azure.com; connect-src 'self' https://fahsak-api.azurewebsites.net https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com https://westeurope-5.in.applicationinsights.azure.com https://js.monitor.azure.com;",
    "Cache-Control": "public, max-age=3600"
  }
}
